{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "MySql",
    "ConnectionString": "Server=localhost;Port=3306;Database=wilken_automation;User=root;Password=root;AllowUserVariables=True"
  },
  "Worker": {
    "WorkerCount": 1,
    "AutomationMode": "DesktopTest",
    "PollIntervalMs": 1000,
    "HeartbeatIntervalMs": 2000,
    "ApiBaseUrl": "http://localhost:5210"
  },
  "Jwt": {
    "Issuer": "WilkenAutomation",
    "Audience": "WilkenAutomation.Clients",
    "Key": "WilkenAutomation-DevOnly-ChangeThisKey-32ch",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "WorkerTokenHours": 12
  },
  "Wilken": {
    "ExecutablePath": "",
    "MainWindowTitle": "Wilken CS/2 Test Desktop",
    "ProcessName": "WilkenAutomation.TestDesktop",
    "Username": "tester",
    "Password": "tester",
    "MaxAttempts": 3,
    "StartupTimeoutSeconds": 60,
    "LoginTimeoutSeconds": 30,
    "NavigationTimeoutSeconds": 30,
    "ReportTimeoutMinutes": 20,
    "ExportTimeoutMinutes": 10,
    "FileCreationTimeoutSeconds": 120,
    "PollingIntervalMs": 400,
    "Selectors": {
      "LoginUsername": "AutomationId:LoginUsername",
      "LoginPassword": "AutomationId:LoginPassword",
      "LoginButton": "AutomationId:LoginButton",
      "ClientField": "AutomationId:ClientField",
      "AssetAccountingMenu": "AutomationId:AssetAccountingMenu",
      "AssetAccountingWindowMarker": "AutomationId:AssetAccountingWindowMarker",
      "FiscalYearField": "AutomationId:FiscalYearField",
      "DepartmentField": "AutomationId:DepartmentField",
      "ExecuteButton": "AutomationId:ExecuteButton",
      "ReportStatusIndicator": "AutomationId:ReportStatusIndicator",
      "ReportReadyText": "Ready",
      "SpoolMenu": "AutomationId:SpoolMenu",
      "SpoolList": "AutomationId:SpoolList",
      "ExportButton": "AutomationId:ExportButton",
      "SaveDialogFileName": "AutomationId:SaveDialogFileName",
      "SaveDialogConfirm": "AutomationId:SaveDialogConfirm",
      "UnexpectedDialog": "AutomationId:UnexpectedDialog",
      "DialogOkButton": "AutomationId:DialogOkButton",
      "KnownDialogTitles": "Save export",
      "DismissibleButtonNames": "OK|Close|Ja|Yes|Weiter"
    }
  },
  "Export": {
    "RootDirectory": "../Exports",
    "ScreenshotDirectory": "../Logs/Screenshots",
    "GenerateSha256": true,
    "FileExtension": ".csv"
  }
}
