    "VerifiedRunCacheSize": 32,
    "ApiBaseUrl": "http://localhost:5210"
  },
  "Jwt": {
    "Issuer": "WilkenAutomation",
    "Audience": "WilkenAutomation.Clients",
    "Key": "WilkenAutomation-DevOnly-ChangeThisKey-32ch",
    "WorkerKey": "WilkenAutomation-DevOnly-WorkerKey-32chars!",
    "WorkerAudience": "WilkenAutomation.Worker",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "WorkerTokenHours": 1
  },
  "Wilken": {
    "ExecutablePath": "",
    "MainWindowTitle": "Wilken CS/2",
    "ProcessName": null,
    "AttachOnly": true,
    "SkipLogin": true,
    "RequireInspectedSelectors": true,
    "Username": "",
