      "ReportReadyText": "",
      "SpoolMenu": "",
      "SpoolList": "",
      "ExportButton": "",
      "SaveDialogFileName": "",
      "SaveDialogConfirm": "",
      "LoginUsername": "",
      "LoginPassword": "",
      "LoginButton": "",
      "KnownDialogTitles": ""
    }
  },
  "Export": {
    "RootDirectory": "C:\\WilkenExports",
    "ScreenshotDirectory": "C:\\WilkenExports\\Logs\\Screenshots",
    "GenerateSha256": true,
    "FileExtension": ".csv"
  },
  "Maintenance": {
    "IntervalMinutes": 30
  }
