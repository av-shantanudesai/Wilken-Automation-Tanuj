{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "MySql",
    "ConnectionString": "Server=localhost;Port=3306;Database=wilken_automation;User=root;Password=root;AllowUserVariables=True"
  },
  "Worker": {
    "WorkerCount": 1,
    "AutomationMode": "Mock",
    "PollIntervalMs": 1000,
    "HeartbeatIntervalMs": 2000,
