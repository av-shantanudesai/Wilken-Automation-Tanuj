{
  "Urls": "http://localhost:5210",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "MySql"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "WilkenAutomation",
    "Audience": "WilkenAutomation.Clients",
    "WorkerAudience": "WilkenAutomation.Worker",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "WorkerTokenHours": 1
  },
  "Auth": {
    "AllowRegistration": true
  },
  "RunDefaults": {
    "ClientCount": 78,
    "YearFrom": 2003,
    "YearTo": 2025,
    "Departments": [ "Handelsrecht", "Steuerrecht" ]
  },
  "Export": {
    "RootDirectory": "../Exports",
    "ScreenshotDirectory": "../Logs/Screenshots"
  }
}
