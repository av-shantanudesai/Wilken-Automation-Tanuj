<Window x:Class="WilkenCs2ReplicaMock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="1/02 - Frank Krauss GmbH &amp; Co. KG - Wilken_CS/2_Finanzmanagement"
        Width="1720" Height="930" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WilkenBackground}"
        FontFamily="Segoe UI" FontSize="11" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Wilken navigation starts at the very top, as in the recordings. -->
            <Border Grid.Column="0" Background="#E9F2FE" BorderBrush="#6E89AB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="53"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="108"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="13,10,0,0">
                        <TextBlock Text="Wilken" FontSize="18" FontWeight="Bold" Foreground="#006E95" VerticalAlignment="Top"/>
                        <TextBlock Text="  ////" FontSize="22" FontWeight="Bold" Foreground="#006E95"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="12,4,10,5">
                        <TextBox Text="Bitte Suchbegriff eingeben." Foreground="#6E6E6E" Padding="27,0,3,0"
                                 automation:AutomationProperties.AutomationId="Navigation_Search"/>
                        <TextBlock Text="⌕" FontSize="18" Margin="7,1,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#C4D8F2" BorderBrush="#6E89AB" BorderThickness="0,1,0,1">
                        <Grid>
                            <TextBlock Text="Navigation" FontWeight="Bold" Foreground="#163D70" FontSize="13" Margin="8,3"/>
                            <TextBlock Text="✉  ⚒  ↻  ▣  ◀" HorizontalAlignment="Right" Margin="0,3,7,0" Foreground="#315D8D"/>
                        </Grid>
                    </Border>
                    <TreeView x:Name="NavigationTree" Grid.Row="3" Margin="7,0,4,0" Background="White"
                              BorderBrush="#7E96B6" BorderThickness="1" FontSize="11"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged"
                              automation:AutomationProperties.AutomationId="Navigation_Tree"/>
                    <StackPanel Grid.Row="4">
                        <Border Background="#FFC24A" BorderBrush="#6785A6" BorderThickness="0,1,0,1" Padding="5"><TextBlock Text="◉  Navigation" FontWeight="Bold"/></Border>
                        <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="★  Favoriten"/></Border>
                        <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="●  Aktive Fenster"/></Border>
                        <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="♻  Anmeldevarianten"/></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Title/menu/toolbar span the work area + context sidebar, not the navigation pane. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="WorkTitleRow" Height="25"/>
                    <RowDefinition x:Name="WorkMenuRow" Height="20"/>
                    <RowDefinition x:Name="WorkToolbarRow" Height="31"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="WorkTitleBar" Grid.Row="0" Background="{StaticResource WilkenBlue}">
                    <Grid>
                        <TextBlock x:Name="ScreenTitle" Foreground="White" FontSize="13" Margin="8,2,62,0"
                                   Text="Anlagenbuchhaltung - Zugangsliste erstellen"
                                   automation:AutomationProperties.AutomationId="Screen_Title"/>
                        <!-- Internal Wilken child-window controls.  These are NOT the Windows/Citrix application buttons. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <Button x:Name="InternalRestoreButton" Width="25" Height="23" Margin="0,1,0,1"
                                    Padding="0" Content="□" Foreground="White" Background="Transparent"
                                    BorderThickness="0" ToolTip="Wiederherstellen" IsTabStop="False"
                                    automation:AutomationProperties.AutomationId="InternalWindow_Restore"/>
                            <Button x:Name="InternalCloseButton" Width="27" Height="23" Margin="0,1,1,1"
                                    Padding="0" Content="×" FontSize="16" FontWeight="Bold" Foreground="White"
                                    Background="#1F4E8C" BorderThickness="0" ToolTip="Schließen"
                                    automation:AutomationProperties.Name="Schließen"
                                    automation:AutomationProperties.AutomationId="InternalWindow_Close"
                                    Click="InternalCloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="WorkMenuBar" Grid.Row="1" Background="#E7F0FB" BorderBrush="#8CA1BC" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Allgemein" Margin="0,0,15,0"/>
                        <TextBlock x:Name="MenuSecond" Text="Aktionen" Margin="0,0,15,0"/>
                        <TextBlock Text="Hilfe"/>
                    </StackPanel>
                </Border>
                <Border x:Name="WorkToolbarBar" Grid.Row="2" Background="#D3E4F8" BorderBrush="#8CA1BC" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="8,3,0,3">
                        <StackPanel x:Name="ToolbarStandardControls" Orientation="Horizontal">
                            <TextBox Width="43" Height="21" Margin="0,1,1,1" Background="#FFF0A8"
                                     automation:AutomationProperties.AutomationId="Toolbar_Command"/>
                            <Button Width="24" Content="›"/>
                            <Button Width="28" Content="□"/><Button Width="28" Content="▣"/><Button Width="28" Content="⌕"/>
                            <Button Width="28" Content="▣"/><Button Width="28" Content="↶"/><Button Width="28" Content="↷"/>
                            <Button Width="28" Content="⊠"/><Button Width="28" Content="✕"/>
                            <Separator Width="8"/>
                        </StackPanel>
                        <Button x:Name="ExecuteButton" Width="31" Content="✓" ToolTip="Ausführen"
                                automation:AutomationProperties.AutomationId="Toolbar_Execute" Click="ExecuteButton_Click"/>
                        <StackPanel x:Name="ToolbarTailControls" Orientation="Horizontal">
                            <Separator Width="8"/><Button Width="28" Content="?"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="RightColumn" Width="215"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource WilkenBackground}" Padding="0">
                        <Grid>
                            <ContentControl x:Name="MainContent"/>
                            <!-- Druckauswahl stays inside this work area (same tab as Prozesse verwalten), not a separate window. -->
                            <Border x:Name="PrintSelectionOverlay" Visibility="Collapsed" Panel.ZIndex="20"
                                    Background="#66000000">
                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="18,14,18,14"
                                        Background="#B8D3F6" BorderBrush="#6E89AB" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <ContentControl x:Name="PrintSelectionHost" Margin="0"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="RightPanel" Grid.Column="1" Background="#D9E8FA" BorderBrush="#6E89AB" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="139"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Border Background="#BDD3F0" BorderBrush="#6E89AB" BorderThickness="0,0,0,1" Padding="6">
                                    <TextBlock x:Name="RightPrimaryTitle" Text="Dokumente" FontWeight="Bold" FontSize="13" Foreground="#365C86"/>
                                </Border>
                                <StackPanel x:Name="RightPrimaryItems" Margin="8,8,4,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,1,0,1" Padding="4"><TextBlock Text="▣  Dokumente" FontWeight="Bold"/></Border>
                                <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock x:Name="ProtocolCount" Text="▱  Protokolle/Listen (2)"/></Border>
                                <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="▱  Notizen"/></Border>
                                <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="ⓘ  Tooltips"/></Border>
                                <Border Background="#FFC24A" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock x:Name="FollowUpCount" Text="➜  Folgeaktionen (1)"/></Border>
                                <Border Background="#BDD7F7" BorderBrush="#7792B1" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="ⓘ  Informationen"/></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#EDF4FC" BorderBrush="#718BAA" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="8,3" Text="BHL"/>
                <TextBlock Grid.Column="1" Margin="8,3" x:Name="StatusClock" Text="15.39.41"/>
                <TextBlock Grid.Column="2" Margin="8,3" x:Name="StatusModule" Text="CA50"/>
                <TextBlock Grid.Column="3" Margin="8,3" x:Name="StatusText" Text="Bereit"
                           automation:AutomationProperties.AutomationId="Status_Text"/>
                <TextBlock Grid.Column="4" Margin="8,3" x:Name="StatusPage" Text="1/2" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
